{
	"name": "obsidian-debugger-highlight",
	"version": "0.1.0",
	"description": "Syntax highlighting for GDB / pwndbg / GEF / PEDA output in Obsidian code blocks.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test 'test/*.test.ts'",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"gdb",
		"pwndbg",
		"gef",
		"peda",
		"syntax-highlighting",
		"prism"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@types/node": "^22.20.5",
		"@types/prismjs": "^1.26.6",
		"esbuild": "^0.25.5",
		"obsidian": "^1.14.4",
		"prismjs": "^1.30.0",
		"typescript": "^5.9.3"
	}
}
