{
	"name": "obsidian-debugger-highlight",
	"version": "0.1.0",
	"description": "Syntax highlighting for GDB / pwndbg / GEF / PEDA output in Obsidian code blocks.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test 'test/*.test.ts'",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"install-vault": "npm run build && node scripts/install-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"gdb",
		"pwndbg",
		"gef",
		"peda",
		"syntax-highlighting",
		"prism"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"@types/prismjs": "^1.26.6",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"prismjs": "^1.30.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.73.0"
	},
	"author": "ott3r07",
	"repository": {
		"type": "git",
		"url": "https://github.com/ott3r07/obsidian-debugger-highlight.git"
	}
}
